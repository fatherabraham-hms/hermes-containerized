[Unit]
Description=Hermes Assistant (launch-with-host-env → isolated container)
Documentation=file:///home/bucephalus3/hermes-assistant/MIGRATE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/hermes-assistant
# Non-interactive: load config/env.secrets, sudo -n → /usr/local/sbin/hermes-assistant-privileged.sh
Environment=HERMES_SYSTEMD=1
Environment=HERMES_NONINTERACTIVE=1
Environment=HERMES_OPERATOR_KIT=%h/hermes-assistant
# Do NOT put secrets here — use EnvironmentFile (mode 600):
EnvironmentFile=-%h/hermes-assistant/config/env.secrets
ExecStart=%h/hermes-assistant/scripts/launch-with-host-env.sh start
ExecStop=%h/hermes-assistant/scripts/launch-with-host-env.sh stop
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=default.target
