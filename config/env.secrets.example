# Hermes Assistant — API keys / tokens for systemd autostart
# Copy to env.secrets and fill values (mode 600). NEVER commit env.secrets.
#
#   cp config/env.secrets.example config/env.secrets
#   chmod 600 config/env.secrets
#   # edit values, then:
#   sudo bash scripts/install-autostart.sh
#
# Names must match config/env.allowlist. Interactive launches still prefer
# variables already exported in your shell (env.secrets only fills gaps).

HERMES_TELEGRAM_TOKEN=
VENICE_API_KEY=
BRAVE_SEARCH_API_KEY=
OPEN_WEB_NINJA_API_KEY=
NEWS_API_KEY=
COIN_MARKET_CAP_API_KEY=
MORPHEUS_API_KEY=
MORPHEUS_PROXY_API_KEY=
TAVILY_API_KEY=
